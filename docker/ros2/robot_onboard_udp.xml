<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- On the robot ONLY. Participant IDs/ports are automatic so each local
       controller/gateway/TF/CLI process is independent. Explicit initial PC
       peers reach Desktop's reviewed fixed ports even after local IDs exceed
       the default peer discovery scan range. wlan0 is a real robot interface. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>onboard_udp</transport_id><type>UDPv4</type>
      <maxInitialPeersRange>32</maxInitialPeersRange>
      <interfaceWhiteList><address>192.168.0.100</address><address>127.0.0.1</address></interfaceWhiteList>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="onboard_control" is_default_profile="true">
    <rtps>
      <userTransports><transport_id>onboard_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin><initialPeersList>
        <locator><udpv4><address>192.168.0.180</address><port>7430</port></udpv4></locator>
        <locator><udpv4><address>192.168.0.180</address><port>7432</port></udpv4></locator>
        <locator><udpv4><address>127.0.0.1</address></udpv4></locator>
        <locator><udpv4><address>192.168.0.100</address></udpv4></locator>
      </initialPeersList></builtin>
    </rtps>
  </participant>
</profiles>
