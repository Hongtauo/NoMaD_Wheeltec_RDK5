<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- Live inference + audit + visualizer share ONE context/participant 10.
       Domain 0, discovery UDP 7430, data UDP 7431. Explicitly announce both
       loopback for the same Docker host and Windows Wi-Fi for the robot.
       This avoids relying on Docker Desktop's Wi-Fi-address hairpin path for
       communication with the separate RViz participant 11 on 7432/7433.
       Do not add an interface whitelist, automatic 0.0.0.0 locators, External
       Locators, or Docker internal addresses. UDP wildcard binding is retained.
       Initial peer 127.0.0.1:7432 bootstraps the local RViz participant; the
       192.168.0.100 peer uses the robot's standard domain-0 discovery ports.
       Verify the Wi-Fi address and all four PC participant ports before use.
       The older robot_wifi_only.xml is intentionally unchanged for old runs. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>robot_live_local_wifi_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="robot_live_local_and_wifi" is_default_profile="true">
    <rtps>
      <participantID>10</participantID>
      <userTransports><transport_id>robot_live_local_wifi_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <defaultUnicastLocatorList>
        <locator><udpv4><address>127.0.0.1</address><port>7431</port></udpv4></locator>
        <locator><udpv4><address>192.168.0.180</address><port>7431</port></udpv4></locator>
      </defaultUnicastLocatorList>
      <builtin>
        <metatrafficUnicastLocatorList>
          <locator><udpv4><address>127.0.0.1</address><port>7430</port></udpv4></locator>
          <locator><udpv4><address>192.168.0.180</address><port>7430</port></udpv4></locator>
        </metatrafficUnicastLocatorList>
        <initialPeersList>
          <locator><udpv4><address>127.0.0.1</address><port>7432</port></udpv4></locator>
          <locator><udpv4><address>192.168.0.100</address></udpv4></locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
