<?xml version="1.0" encoding="UTF-8"?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <!-- Docker Desktop host-network image-only experiment. ONE participant only.
       Wi-Fi IP must be rechecked before each use. Do NOT add an interface whitelist:
       Fast DDS UDP binds wildcard interfaces while these explicit locators are announced.
       No External Locators: avoid appending unreachable Docker internal addresses.
       No motion publishers or controllers. Fixed domain 0, participant 10. -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>wifi_only_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="wifi_only_camera_test" is_default_profile="true">
    <rtps>
      <participantID>10</participantID>
      <userTransports><transport_id>wifi_only_udp</transport_id></userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <defaultUnicastLocatorList>
        <locator><udpv4><address>192.168.0.180</address><port>7431</port></udpv4></locator>
      </defaultUnicastLocatorList>
      <builtin>
        <metatrafficUnicastLocatorList>
          <locator><udpv4><address>192.168.0.180</address><port>7430</port></udpv4></locator>
        </metatrafficUnicastLocatorList>
        <initialPeersList>
          <locator><udpv4><address>192.168.0.100</address></udpv4></locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
